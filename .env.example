# =====================================================================
# KampusKu — Portal Akademik Fiktif
# Salin file ini menjadi ".env" lalu sesuaikan nilainya.
# JANGAN pernah meng-commit file .env ke repository publik.
# =====================================================================

# Port HTTP server
PORT=3000

# Alamat host server
HOST=127.0.0.1

# Rahasia sesi — WAJIB diganti dengan string acak panjang saat deploy.
# Contoh cara membuat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ganti-dengan-string-acak-panjang

# environment: development | production | test
NODE_ENV=development

# --- Laboratorium kerentanan (HANYA untuk lingkungan lokal) ------------
# true  -> jalur /lab/* dapat diakses
# false -> jalur /lab/* DITUTUP (wajib untuk deployment publik)
# Nilai kosong: otomatis true di development, false di production.
LAB_ENABLED=true

# Batas ukuran unggahan tugas (byte). Default: 5 MB
MAX_UPLOAD_BYTES=5242880

# Jumlah maksimal kegagalan login portal utama sebelum ditahan sementara.
# (Perlindungan login utama — TIDAK dipakai oleh laboratorium.)
LOGIN_MAX_FAILS=8
LOGIN_LOCK_SECONDS=300

# --- Penyimpanan (lokal: biarkan default) -------------------------------
# memory/disk (default lokal) = perilaku asli, sesi di memori, unggahan di folder UPLOAD_DIR.
# blobs (dipilih otomatis oleh netlify/functions/app.js saat deploy Netlify)
#   = sesi & berkas unggahan disimpan di Netlify Blobs (tersedia di paket gratis).
SESSION_BACKEND=memory
STORAGE_BACKEND=disk

# Mirror database SQLite ke Netlify Blobs agar data tidak hilang saat cold start.
# Default lokal false. Catatan jujur: ini bukan database bersama — memakai
# semantik last-write-wins, cukup untuk demo trafik rendah.
DB_MIRROR=false

# --- Hanya relevan untuk deployment Netlify (diisi otomatis oleh adapter) --
# APP_ROOT       : root bundle di dalam artefak fungsi (views/, public/, data/)
# TMP_DIR        : direktori writable (Linux: /tmp)
# Keduanya TIDAK perlu diisi manual; hanya isi bila ingin menimpa perilaku adapter.
