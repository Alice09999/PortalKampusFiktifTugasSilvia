<% if (typeof flash !== 'undefined' && flash && flash.length) { %>
  <% flash.forEach(function (f) { %>
    <div class="alert <%= f.type === 'success' ? 'success' : (f.type === 'warning' ? 'warning' : (f.type === 'info' ? 'info' : 'error')) %>" role="alert">
      <span><strong><%= f.type === 'success' ? 'Berhasil' : (f.type === 'warning' ? 'Perhatian' : 'Informasi') %>: </strong><%= f.text %></span>
      <button class="close" type="button" aria-label="Tutup">&times;</button>
    </div>
  <% }) %>
<% } %>
